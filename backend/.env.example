# ==============================================================
# Cloud-Based College Placement Management System
# Backend Environment Configuration Template
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Cloud Database: MongoDB Atlas Connection URI
# Example: mongodb+srv://admin_user:YourSecretPass@cluster0.xxxxx.mongodb.net/placement_db?retryWrites=true&w=majority
# For local dev fallback without Atlas: mongodb://127.0.0.1:27017/placement_db
MONGODB_URI=mongodb://127.0.0.1:27017/placement_db

# Security & JSON Web Tokens
JWT_SECRET=super_secret_jwt_key_placement_system_2026_change_in_production
JWT_EXPIRES_IN=24h

# Cloud Object Storage: Amazon Web Services (AWS) S3
# For local dev mode without active AWS account, the application automatically
# falls back to a secure local uploads directory while maintaining full S3 API compatibility.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=college-placement-resumes-dev

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173
