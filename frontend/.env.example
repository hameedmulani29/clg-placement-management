# API Gateway URL (leave empty for Vite proxy in development, set to cloud URL in production)
VITE_API_BASE_URL=

# -------------------------------------------------------------
# FIREBASE GOOGLE AUTHENTICATION (CLIENT)
# -------------------------------------------------------------
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
